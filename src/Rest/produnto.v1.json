{
	"mwapi": "1.1.0",
	"info": {
		"title": "Produnto API",
		"version": "1.0.0",
		"x-i18n-title": "rest-module-produnto.v1-title",
		"x-i18n-description": "rest-module-produnto.v1-description"
	},
	"moduleId": "produnto/v1",
	"paths": {
		"/deployments/recent": {
			"get": {
				"x-i18n-description": "rest-endpoint-desc-get-produnto-deployments-recent",
				"handler": {
					"class": "MediaWiki\\Extension\\Produnto\\Rest\\RecentDeploymentsHandler",
					"services": [
						"Produnto.Store",
						"PermissionManager",
						"ConnectionProvider"
					]
				}
			}
		},
		"/deployment/validate": {
			"post": {
				"x-i18n-description": "rest-endpoint-desc-post-produnto-deployments-validate",
				"handler": {
					"class": "MediaWiki\\Extension\\Produnto\\Rest\\ValidateDeploymentHandler",
					"services": [
						"Produnto.Updater",
						"ContentLanguage",
						"MessageFormatterFactory"
					]
				}
			}
		},
		"/deployment/patch": {
			"post": {
				"x-i18n-description": "rest-endpoint-desc-post-produnto-deployment-patch",
				"handler": {
					"class": "MediaWiki\\Extension\\Produnto\\Rest\\PatchDeploymentHandler",
					"services": [
						"ContentLanguage",
						"MessageFormatterFactory",
						"PageUpdaterFactory",
						"PageStore",
						"Produnto.AuthorizingPageSaverFactory",
						"Produnto.Updater"
					]
				}
			}
		},
		"/packages/all/": {
			"get": {
				"x-i18n-description": "rest-endpoint-desc-get-produnto-packages-all-index",
				"handler": {
					"class": "MediaWiki\\Extension\\Produnto\\Rest\\PackagesIndexHandler",
					"services": [
						"MainConfig",
						"Produnto.Store",
						"PermissionManager"
					]
				}
			}
		},
		"/packages/all/{partition}": {
			"get": {
				"x-i18n-description": "rest-endpoint-desc-get-produnto-packages-all-partition",
				"handler": {
					"class": "MediaWiki\\Extension\\Produnto\\Rest\\PackagesListHandler",
					"services": [
						"MainConfig",
						"Produnto.Store",
						"PermissionManager",
						"ContentLanguage",
						"MessageFormatterFactory"
					]
				}
			}
		},
		"/gitlab/tag": {
			"post": {
				"x-i18n-description": "rest-endpoint-desc-post-produnto-gitlab-tag",
				"handler": {
					"class": "MediaWiki\\Extension\\Produnto\\Rest\\GitlabTagHandler",
					"services": [
						"Produnto.ServerContainer",
						"Produnto.Fetcher",
						"Produnto.Logger"
					]
				}
			}
		},
		"/sandbox": {
			"get": {
				"x-i18n-description": "rest-endpoint-desc-get-produnto-sandbox-list",
				"handler": {
					"class": "MediaWiki\\Extension\\Produnto\\Rest\\SandboxListHandler",
					"services": [
						"Produnto.SandboxStore"
					]
				}
			}
		},
		"/sandbox/{id}": {
			"post": {
				"x-i18n-description": "rest-endpoint-desc-post-produnto-sandbox",
				"handler": {
					"class": "MediaWiki\\Extension\\Produnto\\Rest\\SandboxPostHandler",
					"services": [
						"Produnto.Store",
						"Produnto.SandboxStore",
						"Produnto.ManifestFactory"
					]
				}
			},
			"delete": {
				"x-i18n-description": "rest-endpoint-desc-delete-produnto-sandbox",
				"handler": {
					"class": "MediaWiki\\Extension\\Produnto\\Rest\\SandboxDeleteHandler",
					"services": [
						"Produnto.SandboxStore"
					]
				}
			}
		},
		"/sandbox/{id}/activate": {
			"post": {
				"x-i18n-description": "rest-endpoint-desc-post-produnto-sandbox-activate",
				"handler": {
					"class": "MediaWiki\\Extension\\Produnto\\Rest\\SandboxActivateHandler",
					"services": [
						"Produnto.SandboxStore"
					]
				}
			}
		},
		"/sandbox/{id}/deactivate": {
			"post": {
				"x-i18n-description": "rest-endpoint-desc-post-produnto-sandbox-deactivate",
				"handler": {
					"class": "MediaWiki\\Extension\\Produnto\\Rest\\SandboxDeactivateHandler"
				}
			}
		}
	}
}
